{
  "name": "3dviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time web viewer for 3D Gaussian splats, meshes, and point clouds.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/check-precache.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:assets": "node scripts/generate-assets.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@sparkjsdev/spark": "2.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.4",
    "@types/three": "^0.180.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
